{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folder Explorer",
  "version": "../package.json",
  "identifier": "com.folderexplorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://fe.localhost",
        "media-src": "'self' http://fe.localhost",
        "connect-src": "'self' http://ipc.localhost http://fe.localhost",
        "frame-src": "http://fe.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Folder Explorer",
    "copyright": "© 2026 Folder Explorer",
    "category": "Utility",
    "shortDescription": "Telefon tarzı klasörlerle Windows masaüstü",
    "longDescription": "Masaüstü simgelerini telefondaki gibi birleştirip klasörlemeni sağlar. Klasörler sanaldır; dosyalar yerinden oynamaz.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
